{
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/remix",
        "config": {
          "installCommand": "npm install",
          "buildCommand": "npm run build"
        }
      }
    ],
    "routes": [
      {
        "src": "/build/(.*)",
        "headers": { "cache-control": "public, max-age=31536000, immutable" },
        "continue": true
      },
      { "src": "/(.*)", "dest": "/" }
    ]
  }
  